NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
# --- Database ---------------------------------------------------------------
# Neon (recommended for hosted demos):
#   DATABASE_URL = POOLED connection string  (host ends with -pooler, ?sslmode=require&pgbouncer=true)
#   DIRECT_URL   = DIRECT connection string  (host WITHOUT -pooler) — used by `prisma migrate`
# Local PostgreSQL: set both to the same URL.
DATABASE_URL="postgresql://postgres@localhost:5432/gallops?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/gallops?schema=public"
# Rotate this in production. Min 32 chars.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public base URL used to build QR payloads and tracking links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# --- Realtime ---------------------------------------------------------------
# Set NEXT_PUBLIC_SOCKET_ENABLED=false on serverless hosts (Vercel) that cannot
# run the Socket.IO server. The UI then falls back to polling: reception and
# kitchen every 15 s, guest order tracking every 20 s.
NEXT_PUBLIC_SOCKET_ENABLED="true"
# Absolute origin of a Socket.IO server on another host. Leave empty for the
# normal single-process deployment. Set SOCKET_CORS_ORIGIN on that host to this
# app's origin, e.g. SOCKET_CORS_ORIGIN="https://gallops.vercel.app"
NEXT_PUBLIC_SOCKET_URL=""
# Local object storage for uploads (swap for Cloudinary/S3 in production)
UPLOAD_DIR="./uploads"
UPLOAD_PROVIDER="local"
# Session cookie. Production builds default to Secure; set false ONLY when
# serving over plain HTTP (local sandbox / LAN demo) or the browser will drop it.
COOKIE_SECURE="false"
# --- Optional integrations (all disabled until configured) ---
RAZORPAY_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
WEB_PUSH_ENABLED="false"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@gallopsfoodplaza.in"
SMTP_ENABLED="false"
SMTP_URL=""
SMTP_FROM="Gallops Restaurant <no-reply@gallopsfoodplaza.in>"
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER_URL=""
WHATSAPP_TOKEN=""
SMS_ENABLED="false"
SMS_PROVIDER_URL=""
SMS_TOKEN=""
PLATFORM_BILLING_MODE="development"
# --- Android app (Trusted Web Activity / Bubblewrap) -----------------------
ANDROID_PACKAGE_NAME="com.gallops.app"
# SHA-256 fingerprint(s) of the APK signing cert, comma separated.
# keytool -list -v -keystore android.keystore -alias gallops | grep SHA256
ANDROID_SHA256_CERT=""


# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# DATABASE_URL  - PostgreSQL connection string (Prisma)
# AUTH_SECRET   - openssl rand -base64 32
# UPLOAD_PROVIDER - local | cloudinary
# CLOUDINARY_URL  - required when UPLOAD_PROVIDER=cloudinary
# RAZORPAY_*    - Indian payments. Leave RAZORPAY_ENABLED=false to run with
#                 "cash at counter" only. Payments are NEVER marked paid
#                 without signature/webhook verification.
# WEB_PUSH_*    - run `npm run vapid` to generate VAPID keys.
# SMTP_*, WHATSAPP_*, SMS_* - notification providers, optional.
# COOKIE_SECURE       - false for HTTP demos, true (default) once HTTPS is live
# PLATFORM_BILLING_MODE - development | live
